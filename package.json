{
  "name": "dsh-role-play",
  "version": "1.7.0",
  "description": "一个可随意设置角色卡的轻量角色扮演，安装即用，简单易上手。支持长/中/短三种对话模式、一键强化情感张力、成人向描写开关（含模型适配提示）、主控人称与配角视角控制、自动记忆与角色状态栏，可感知当前真实时间与日期。角色的记忆、对话与角色卡全部保存在浏览器本地存储，不写任何文件。可搭配「多角色故事」扩展，让多个角色同场互动。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "roleplay",
    "sillytavern",
    "chat"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "RELEASE_NOTES_v1.7.0.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
